<h1>上映登録</h1>
<%= form_with model: [:admin, @movie, @schedule] do |form| %>
    <% if form.object.errors.any? %>
        <p class="error"><%= form.object.errors.full_messages.first %></p>
    <% end %>
<!--    <div>
        上映映画ID
        <%#= form.text_field :movie_id %>-->
<!--    </div>-->
    <div>
        上映開始時間
        <%= form.datetime_local_field :start_time %>
    </div>
    <div>
        上映終了時間
        <%= form.datetime_local_field :end_time %>
    </div>
    <div>
        <%= form.submit "登録する" %>
    </div>
<% end %>

<%= link_to "Back", admin_movie_path(@movie) %>