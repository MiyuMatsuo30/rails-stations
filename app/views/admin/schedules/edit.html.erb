<h1>上映情報編集</h1>
<%= form_with model: [:admin, @movie, @schedule] do |form| %>
    <% if form.object.errors.any? %>
        <p class="error"><%= form.object.errors.full_messages.first %></p>
    <% end %>
    <div>
        上映開始時間
        <%= form.datetime_local_field :start_time %>
    </div>
    <div>
        上映終了時間
        <%= form.datetime_local_field :end_time %>
    </div>
    <div>
        <%= form.submit "登録する" %>
    </div>
<% end %>

<script>
    function check(){
        if(window.confirm("本当に削除しますか？")){
            return true;
        }else{
            window.alert("キャンセルされました")
            return false;
        }
    }
</script>

<%= link_to "Back", admin_movies_path %>
<%= button_to "削除", admin_movie_schedule_path(@movie, @schedule.id), method: :delete, data: { turbo: false }, form: {onSubmit: "return check()"} %>
