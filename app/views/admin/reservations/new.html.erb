<h1>映画予約作成ページ</h1>
<table>
<%= form_with model: [:admin, @reservation] do |form| %>
    <tr>
        <th>日時</th>
        <td><%= form.date_field :date %></td>
    </tr>
    <tr>
        <th>sheet_id</th>
        <td><%= form.text_field :sheet_id %></td>
    </tr>
    <tr>
        <th>schedule_id</th>
        <td><%= form.text_field :schedule_id %></td>
    </tr>
    <tr>
        <th>名前</th>
        <td><%= form.text_field :name %></td>
    </tr>
    <tr>
        <th>メールアドレス</th>
        <td><%= form.text_field :email %></td>
    </tr>
</table>
<tr><%= form.submit "座席を予約する" %></tr>
<% end %>

<div><%= link_to "Back", admin_reservations_path %></div>