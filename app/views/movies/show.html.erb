<% if flash[:notice] %>
    <div class="alert alert-success"><%= notice %></div>
<% end %>
<% if flash[:alert] %>
    <div class="alert alert-success"><%= alert %></div>
<% end %>
<h1><%= @movie.name %></h1>
<table class="item-table">
    <tr>
        <th></th>
        <td><img src="<%= @movie.image_url %>"></td>
    </tr>
    <tr>
        <th>公開年</th>
        <td><%= @movie.year %></td>
    </tr>
    <tr>
        <th>上映中か</th>
        <td><%= @movie.is_showing ? "上映中" : "公開予定" %></td>
    </tr>
    <tr>
        <th>概要</th>
        <td><%= @movie.description %></td>
    </tr>
</table>

<% if @movie.is_showing? %>
    <h1>上映スケジュール</h1>
    <table class="text-center">
        <% @times.each do |schedule| %>
        <tr>
            <td><%= schedule.showing_time %></td>
        </tr>
        <% end %>
    </table>

    <h1>上映予約</h1>
    <%= form_with url: "/movies/#{@movie.id}/reservation", method: :get do |form| %>
        <div>
            <%= form.select :date, [*0..7].map {|n| [(Date.today+n).strftime("%Y年%m月%d日"), Date.today+n]} %>
            <%= form.select :schedule_id, @schedules.map {|schedule| [schedule.showing_time, schedule.id]} %>
            <%= form.submit "座席を予約する" %>
        </div>
    <% end %>
<% end %>

<%= link_to "Back", movies_path %>