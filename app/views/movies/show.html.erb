<h1><%= @movie.name %></h1>
<table class="item-table">
    <tr>
        <th>id</th>
        <th>公開年</th>
        <th>上映中か</th>
        <th>概要</th>
        <th>画像URL</th>
        <th>作成日時</th>
        <th>更新日時</th>
    </tr>
    <tr>
        <td><%= @movie.id %></td>
        <td><%= @movie.year %></td>
        <td><%= @movie.is_showing ? "上映中" : "公開予定" %></td>
        <td><%= @movie.description %></td>
        <td><img src=<%= @movie.image_url %>></td>
        <td><%= @movie.created_at %></td>
        <td><%= @movie.updated_at %></td>
    </tr>
</table>

<h1>上映スケジュール</h1>
<table class="text-center">
    <% @schedules.each do |schedule| %>
    <tr>
        <td><%= schedule["start_time"].strftime("%Y年%m月%d日 %H時%M分") %>〜<%= schedule["end_time"].strftime("%H時%M分") %></td>
    </tr>
    <% end %>
</table>

<%= link_to "Back", movies_path %>